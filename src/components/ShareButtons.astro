---
interface Props {
  url: string;
  title?: string;
}

const { url, title = 'Evangelio para Hoy' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const shareLinks = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`, icon: 'whatsapp' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`, icon: 'facebook' },
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`, icon: 'x' },
];
---
<div class="share-buttons flex items-center gap-3 flex-wrap">
  <span class="text-sm text-brand-600 font-serif">Comparte el evangelio:</span>
  {shareLinks.map((s) => (
    <a
      href={s.href}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn-{s.icon}"
      aria-label={`Compartir en ${s.label}`}
    >
      {s.label === 'WhatsApp' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.38c-.24.68-1.42 1.31-1.95 1.31-.5.07-1.12.1-1.81-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.95-4.36-.14-.19-1.18-1.57-1.18-2.99 0-1.42.74-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.17.28.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.34 1.46.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.66-.14.27.1 1.7.8 1.99.95.29.14.48.22.55.34.07.12.07.68-.17 1.36z"/>
        </svg>
      )}
      {s.label === 'Facebook' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.54-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/>
        </svg>
      )}
      {s.label === 'X' && (
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      )}
      <span>{s.label}</span>
    </a>
  ))}
  <button type="button" class="share-btn share-btn-copy" data-copy-url={url} aria-label="Copiar enlace">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
    </svg>
    <span>Copiar</span>
  </button>
</div>

<style>
  .share-btn {
    @apply inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-sans font-medium transition-colors border;
  }
  .share-btn-whatsapp {
    @apply bg-white text-green-700 border-green-200 hover:bg-green-50;
  }
  .share-btn-facebook {
    @apply bg-white text-blue-700 border-blue-200 hover:bg-blue-50;
  }
  .share-btn-x {
    @apply bg-white text-gray-800 border-gray-200 hover:bg-gray-50;
  }
  .share-btn-copy {
    @apply bg-white text-brand-700 border-brand-200 hover:bg-brand-50 cursor-pointer;
  }
  .share-btn-copy.copied {
    @apply bg-green-100 text-green-700 border-green-300;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-copy-url]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-copy-url');
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const label = btn.querySelector('span');
          if (label) {
            const original = label.textContent;
            label.textContent = '¡Copiado!';
            btn.classList.add('copied');
            setTimeout(() => {
              label.textContent = original;
              btn.classList.remove('copied');
            }, 2000);
          }
        } catch {
          // fallback
          const input = document.createElement('input');
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }
      });
    });
  });
</script>