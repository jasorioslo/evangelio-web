---
import WhatsAppCTA from './WhatsAppCTA.astro';

const navItems = [
  { href: '/hoy/', label: 'Hoy' },
  { href: '/calendario/', label: 'Calendario' },
  { href: '/autor/padre-jose-miguel/', label: 'El Padre' },
  { href: '/sobre/', label: 'Sobre' },
];
const { pathname } = Astro.url;
---
<header class="border-b border-brand-200 bg-white backdrop-blur sticky top-0 z-40">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-serif text-2xl sm:text-3xl text-brand-700 font-bold tracking-tight">
        Evangelio para Hoy
      </span>
    </a>
    <nav class="hidden sm:flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`font-serif text-lg transition-colors ${
            pathname?.startsWith(item.href) ? 'text-brand-700 font-bold' : 'text-brand-600 hover:text-brand-800'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <WhatsAppCTA variant="compact" />
      <a
        href="https://www.youtube.com/@evangelioparahoy7"
        target="_blank"
        rel="noopener"
        class="btn-ghost text-sm hidden sm:inline-flex"
        aria-label="Canal de YouTube Evangelio para Hoy"
      >
        YouTube
      </a>
    </div>
  </div>
</header>