---
const whatsappUrl = 'https://whatsapp.com/channel/0029Vb8gvlCInlqSAi9Wjo2U';
interface Props {
  variant?: 'banner' | 'inline' | 'compact';
}
const { variant = 'banner' } = Astro.props;
---
{variant === 'banner' && (
  <div class="whatsapp-cta bg-green-50 border border-green-200 rounded-2xl p-6 text-center">
    <p class="font-serif text-xl text-brand-800 font-bold">Únete a nuestro canal de WhatsApp</p>
    <p class="mt-2 text-sm text-brand-600">Recibe el evangelio y la reflexión de cada día directamente en tu WhatsApp.</p>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener"
      class="mt-4 inline-flex items-center gap-2 bg-green-600 text-white px-6 py-3 rounded-lg font-serif text-lg hover:bg-green-700 transition-colors shadow-sm"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.38c-.24.68-1.42 1.31-1.95 1.31-.5.07-1.12.1-1.81-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.95-4.36-.14-.19-1.18-1.57-1.18-2.99 0-1.42.74-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.17.28.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.34 1.46.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.66-.14.27.1 1.7.8 1.99.95.29.14.48.22.55.34.07.12.07.68-.17 1.36z"/>
      </svg>
      Unirme al canal
    </a>
  </div>
)}

{variant === 'inline' && (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 text-green-700 hover:text-green-800 font-serif text-lg"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/>
    </svg>
    Únete al canal de WhatsApp
  </a>
)}

{variant === 'compact' && (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1.5 text-sm text-green-700 hover:text-green-800 transition-colors"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/>
    </svg>
    WhatsApp
  </a>
)}