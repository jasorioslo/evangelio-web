---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { getCollection } from 'astro:content';
import { formatFechaCorta } from '../utils/liturgia';

const title = 'Página no encontrada — Evangelio para Hoy';
const description = 'La página que buscas no existe. Te llevamos al evangelio de hoy, al calendario y a los últimos días publicados.';

const entries = (await getCollection('evangelio')).sort((a, b) => (a.id > b.id ? -1 : 1));
const ultimos7 = entries.slice(0, 7);
const totalDias = entries.length;
---
<BaseLayout title={title} description={description} noindex={true}>
  <section class="container-wide py-20">
    <div class="text-center">
      <p class="font-serif text-8xl sm:text-9xl text-brand-300 font-bold">404</p>
      <h1 class="mt-4 font-serif text-3xl sm:text-4xl text-brand-700 font-bold">Página no encontrada</h1>
      <p class="mt-4 text-brand-600 font-serif text-xl">
        La página que buscas no existe o fue trasladada.
      </p>
      <p class="mt-2 text-brand-700 font-serif text-lg italic">
        Pero el evangelio de hoy sí está aquí:
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/hoy/" class="btn-primary">Ir al evangelio de hoy</a>
        <a href="/calendario/" class="btn-ghost">Ver calendario</a>
        <a href="/sobre/" class="btn-ghost">Sobre el sitio</a>
      </div>
    </div>

    {ultimos7.length > 0 && (
      <div class="mt-16 max-w-2xl mx-auto">
        <h2 class="font-serif text-2xl text-brand-700 font-bold mb-6 text-center border-b border-brand-200 pb-3">
          Últimos días publicados
        </h2>
        <ul class="space-y-3">
          {ultimos7.map((entry) => (
            <li>
              <a
                href={`/evangelio/${entry.slug}/`}
                class="flex items-baseline gap-4 p-4 bg-brand-50 hover:bg-brand-100 rounded-lg transition-colors group"
              >
                <span class="font-serif text-lg text-brand-700 font-bold flex-shrink-0 tabular-nums">
                  {formatFechaCorta(entry.slug)}
                </span>
                <span class="flex-1">
                  <span class="text-brand-800 group-hover:text-accent transition-colors">
                    {entry.data.titulo_dia || 'Evangelio del día'}
                  </span>
                  {entry.data.evangelio?.referencia && (
                    <span class="block text-sm text-brand-500 italic mt-0.5">
                      {entry.data.evangelio.referencia}
                    </span>
                  )}
                </span>
                <span class="text-brand-400 group-hover:text-accent transition-colors">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <WhatsAppCTA variant="banner" />
        </div>
      </div>
    )}
  </section>
</BaseLayout>