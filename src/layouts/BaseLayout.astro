---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string[];
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/img/og-default.webp',
  keywords = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Evangelio para Hoy';
const siteOrigin = Astro.site?.href ?? 'https://evangelioparahoy.com/';
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;
const ogImageAbsolute = new URL(ogImage, siteOrigin).href;

const jsonLdArray = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const websiteJSON = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteOrigin.replace(/\/$/, ''),
  inLanguage: 'es-MX',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteOrigin}evangelio/{search_term_string}/`,
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />

    {/* Robots: max-image-preview:large para Google Discover */}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    {/* OpenGraph */}
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    {/* Fonts preload */}
    <link rel="preload" href="/fonts/CormorantGaramond-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/CormorantGaramond-Regular.ttf" as="font" type="font/ttf" crossorigin />

    {/* Sitemap + RSS */}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Evangelio para Hoy — RSS" href="/rss.xml" />

    {/* WebSite JSON-LD */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJSON)} />
    {/* Page-specific JSON-LD */}
    {jsonLdArray.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>